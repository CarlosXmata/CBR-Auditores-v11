# Cloudflare Pages: cabeceras (equivalente a "headers" de vercel.json).

# Seguridad: todas las rutas.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

# Archivos con hash de Vite: caché de un año, inmutables.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Las direcciones *.pages.dev (producción y vistas previas) no deben indexarse;
# el sitio público es https://www.cbrauditores.com. No afecta al dominio propio.
https://:project.pages.dev/*
  X-Robots-Tag: noindex
https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
